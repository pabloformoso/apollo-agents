# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env

# Generated artwork (per-session)
artwork/

# Generated output
output/

# Track catalog (generated — use tracks.json.example as template)
tracks/tracks.json

# Audio / video source files (too large for git)
tracks/**/*.wav
tracks/**/*.wav.txt
tracks/**/*.mp3
tracks/**/*.flac
tracks/**/*.m4a
tracks/**/*.ogg
tracks/**/videos/
vids/

# macOS metadata
.DS_Store
tracks/.DS_Store
# Half-finished browser downloads. One rode into the catalog inside a 24 GB
# tar from a Windows box and showed up as an untracked genre folder — the
# audio itself was already covered by `tracks/**/*.wav`, so this stray was the
# only thing git could see.
tracks/**/*.crdownload
tracks/**/*.part
tracks/**/*.download

# Claude project config
.claude/

# CodeGraph local index (per-machine SQLite DB)
.codegraph/

# Agent session memory (personal history)
agent/memory.json
apolloagents_paper.pdf

# Web UI (v2.0)
web/backend/apollo.db
web/frontend/node_modules/
web/frontend/.next/
web/frontend/.next-e2e/
web/frontend/next-env.d.ts

# TypeScript incremental build cache
*.tsbuildinfo

# Playwright E2E
web/frontend/test-results/
web/frontend/playwright-report/
web/frontend/playwright/.cache/
test-results/
playwright-report/
.playwright-mcp/
.tmp/

# Catalog backups + local debug build dirs
tracks/tracks.json.bak
tracks/tracks.json.*.bak
# `ingest_track` stamps its backup as `tracks.json.bak-<stamp>` — a DASH, so
# the two patterns above miss it. Found one in the working tree that had been
# untracked since July.
tracks/tracks.json.bak-*
web/frontend/.next-debug/

# Misc local screenshots
login-*.png

# coverage artifacts
.coverage
cov.json
htmlcov/
