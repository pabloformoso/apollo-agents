# ApolloAgents — environment variables
# Copy this file to .env and fill in your keys

# LLM provider — set at least one
# Anthropic (Claude) — recommended for the agent
ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI — used for DALL-E 3 artwork generation and (optionally) the agent.
# Required when ANTHROPIC_API_KEY is not set, or to generate artwork.
# All four are required together if you use Azure at all.
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your-gpt-deployment-name>

# Image generation (optional — without it, artwork is skipped cleanly).
# Image deployments often live on a DIFFERENT Azure resource than chat
# (different endpoint + key). Set IMAGE_ENDPOINT/IMAGE_API_KEY to override;
# if unset, the chat endpoint/key are reused.
# Models supported: dall-e-3, gpt-image-1, gpt-image-2.
# AZURE_OPENAI_IMAGE_DEPLOYMENT=<your-image-deployment-name>
# AZURE_OPENAI_IMAGE_ENDPOINT=https://<your-image-resource>.cognitiveservices.azure.com/
# AZURE_OPENAI_IMAGE_API_KEY=<separate-key-for-image-resource>

# Optional: pin Azure API versions (defaults are sensible for current deployments)
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_IMAGE_API_VERSION=2024-02-01

# Optional: override the agent model
# AGENT_MODEL=claude-opus-4-6

# LiteLLM proxy (OpenAI-compatible, key required) — e.g. the team's shared
# Qwen deployment. AGENT_MODEL must match the model name registered in the
# proxy (check with: curl <base-url>/models -H "Authorization: Bearer <key>").
# If ANTHROPIC/AZURE keys are also set (e.g. Azure for artwork), keep
# AGENT_PROVIDER=litellm explicit so the agent still uses LiteLLM.
# AGENT_PROVIDER=litellm
# LITELLM_BASE_URL=https://litellm.cloudpunk.org/v1
# LITELLM_API_KEY=sk-...
# AGENT_MODEL=qwen3.6-27b

# Local inference via Ollama (no API key required)
# Install Ollama and run: ollama pull gemma4:4b
# AGENT_PROVIDER=ollama
# AGENT_MODEL=gemma4:4b
# OLLAMA_BASE_URL=http://localhost:11434/v1
#
# The `ollama` provider is really the generic OpenAI-compatible path, so it
# also drives LM Studio (default port 1234) or any other local server. Use
# the server's IP rather than localhost when it lives on another host or the
# backend runs in Docker, and validate the model before pointing a live
# session at it: uv run python scripts/smoke_local_llm.py --base-url ...
#
# THAT "or the backend runs in Docker" IS NOT A NICETY. In a container,
# 127.0.0.1 is the CONTAINER, so a loopback URL here answers [Errno 111]
# Connection refused — and the way it surfaces is the problem: POST
# /api/sessions still returns 200, the session is created, and only the brief
# comes back empty. The page sits on "no brief" with nothing to debug. Cost a
# day on 2026-09-02. Use the host's tailnet IP.
# AGENT_PROVIDER=ollama
# AGENT_MODEL=google/gemma-4-e4b
# OLLAMA_BASE_URL=http://192.0.2.10:1234/v1

# Web UI (v2.0) — change this in production
JWT_SECRET=apollo-agents-change-me

# --- Serving the app over HTTPS -------------------------------------------
# Only needed when the frontend is reached over TLS on a real hostname. Both
# are read by the FRONTEND container (docker-compose passes them through).

# Where the BROWSER opens its WebSockets. Next does not proxy WS, so the
# browser dials the backend directly and lib/ws-base.ts defaults to
# <page host>:4020 — correct on plain HTTP, WRONG under HTTPS, where it would
# ask for wss://<host>:4020 and there is no TLS on that port (the backend
# CONTAINER owns it, so nginx cannot terminate there without stopping prod).
# Hence a second hostname for the socket. Set this in the SAME restart that
# turns HTTPS on: in between, every session and live socket is dead.
# NEXT_PUBLIC_WS_BASE=wss://apollo-api.example.com

# Every hostname the app is REACHED by needs to be here, or Next refuses its
# own dev resources from it: the HMR socket is rejected and retries forever
# (a console nobody can read) and the devtools font 403s. 127.0.0.1 and the
# tailnet IP are compiled in; this extends the list.
# APOLLO_DEV_ORIGINS=apollo.example.com

# YouTube Live Chat integration (v2.7) — optional.
# Set all three to enable the "Connect YouTube" pill on /live; absence
# cleanly disables the feature (the /api/youtube/* endpoints return 404).
# Get the client id/secret from a Google Cloud OAuth 2.0 Client ID
# (https://console.cloud.google.com → APIs & Services → Credentials).
# The redirect URI MUST match what's registered in the OAuth client.
# Dev defaults assume the backend runs on port 4080 (the parallel v2.7
# dev stack); for production update to your deploy's public hostname.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=http://localhost:4080/api/youtube/oauth/callback

# Where the OAuth callback redirects the operator back to after consent.
# Defaults to http://localhost:4040 to match the parallel v2.7 dev stack.
# APOLLO_FRONTEND_URL=http://localhost:4040
