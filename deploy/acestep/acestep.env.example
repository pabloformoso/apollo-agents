# Preserve the model configuration of the existing ACE installation.
ACESTEP_API_KEY=
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-0.6B
ACESTEP_NO_INIT=true

# DiT model. Prod runs the XL turbo (4B) since 2026-11-20, chosen by ear in an
# A/B against acestep-v15-turbo (same prompts and seeds, deep house / techno /
# soul jazz). Download it once with
#   ~/code/ACE-Step-1.5/.venv/bin/acestep-download --model acestep-v15-xl-turbo --skip-main
# (~19 GB fp32). On the 16 GB card it does NOT fit with the defaults: the vLLM
# LM keeps ~6.5 GB reserved and the XL DiT is ~9 GB, so every take OOMs. It fits
# only with the DiT offloaded AND the LM on PyTorch, which offloads too.
# Measured on jarvis, 90 s take: ~36 s warm (~100 s cold) vs ~18 s for
# v15-turbo on vLLM; peak ~11 GB; ~0.8 GB while idle.
# For the old model, drop these four lines (or set ACESTEP_CONFIG_PATH=acestep-v15-turbo).
ACESTEP_CONFIG_PATH=acestep-v15-xl-turbo
ACESTEP_OFFLOAD_DIT_TO_CPU=true
ACESTEP_LM_BACKEND=pt
ACESTEP_LM_OFFLOAD_TO_CPU=true
